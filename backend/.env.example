# Copy to backend/.env and fill in. Never commit the real .env.

# Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Websites allowed to call the API (CORS). Comma-separated for several, e.g.
# http://localhost:3000,https://your-site.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Optional: LLM key for review analysis. Leave blank to use the keyword fallback.
LLM_API_KEY=
